NODE_ENV=development
PORT=4000

# local | supabase — switches which connection strings are used
DATABASE_TARGET=local

# Used when DATABASE_TARGET=local (DATABASE_URL is a backward-compatible alias)
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shawemal
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shawemal

# Used when DATABASE_TARGET=supabase
# SUPABASE_DATABASE_URL: session-mode pooler (prefer port 5432 on the pooler), not the anon key
# SUPABASE_DIRECT_URL: direct db host, used by prisma migrate
# sslmode=require is added automatically if missing
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=15m
JWT_ALGORITHM=HS256
# Exact frontend origin(s), no trailing slash. Comma-separated allowed.
# Vercel Production example: https://shawe-mal-web-smoky.vercel.app
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=12
# disk | vercel-blob | s3 (s3 not implemented yet)
STORAGE_DRIVER=disk
# public | private — must match the Vercel Blob store access mode
BLOB_STORE_ACCESS=private
# Required when STORAGE_DRIVER=vercel-blob (also set on Vercel when the Blob store is linked)
# BLOB_READ_WRITE_TOKEN=
# Optional. Local default: ./uploads. On Vercel (VERCEL=1) default: /tmp/uploads (ephemeral; prefer vercel-blob in production).
UPLOAD_ROOT=
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
# Simulated checkout for subscription and boost demos. No real money moves.
# Has no effect when NODE_ENV=production.
DEMO_PAYMENTS_ENABLED=true

# --- Telegram FAQ bot (server-side only; never expose the token to the frontend) ---
# Bot token from @BotFather. Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Random 16-256 chars (A-Z a-z 0-9 _ -). Telegram sends it with every webhook call; required for the webhook.
TELEGRAM_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
# Public Telegram usernames shown under "Feedback", comma-separated, without @.
TELEGRAM_SUPPORT_USERNAMES=aye432007,sforshein
# Public website address used in the bot's link buttons. Defaults to the first CORS_ORIGIN.
# Must be a public http(s) address: Telegram refuses buttons that point to localhost, so they are hidden.
WEBSITE_URL=
SEED_ADMIN_EMAIL=admin@shawemal.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=ShweMal Admin
SEED_ADMIN_PHONE=09000000001

# --- Vercel dashboard (do not commit secrets) ---
# Create a Vercel project with Root Directory = backend-api.
# Set Production env: NODE_ENV=production, DATABASE_TARGET=supabase,
# SUPABASE_DATABASE_URL, SUPABASE_DIRECT_URL, JWT_SECRET, JWT_EXPIRES_IN,
# JWT_ALGORITHM, CORS_ORIGIN=https://<frontend>.vercel.app,
# STORAGE_DRIVER=vercel-blob, BLOB_STORE_ACCESS=public (or private),
# BLOB_READ_WRITE_TOKEN (from linked Blob store).
# Do not set SEED_ADMIN_* on Vercel; run migrate deploy + seed from your machine.
# Frontend: VITE_API_BASE_URL=https://<this-api>.vercel.app/api/v1

# Generate a random secret for JWT_SECRET
#node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

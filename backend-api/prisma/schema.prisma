generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum HousePostChannel {
  AGENT
  ROOMMATE
}

enum HouseAvailabilityStatus {
  AVAILABLE
  NOT_AVAILABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CancelledByRole {
  USER
  AGENT
  ADMIN
}

enum MovingRequestStatus {
  BOOKED
  ACCEPTED
  ASSIGNED
  DRIVER_COMING
  DRIVER_ARRIVED
  LOADING
  ON_THE_WAY
  UNLOADING
  COMPLETED
  CANCELLED
}

enum MovingStatusEventType {
  CREATED
  ACCEPTED
  REJECTED
  ASSIGNED
  ETA_UPDATED
  STATUS_UPDATED
}

enum RoommateGender {
  MALE
  FEMALE
  ANY
}

enum ReviewTargetType {
  AGENT
  DRIVER
  SELLER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ListingStatus {
  ACTIVE
  SOLD
}

enum ListingModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
}

enum ListingPickupMethod {
  MEET_UP
  SELLER_DELIVERY
  BUYER_PICKUP
  DISCUSS
}

enum ListingReportReason {
  SCAM
  WRONG_INFORMATION
  FAKE_ITEM
  PROHIBITED_ITEM
  DUPLICATE_LISTING
  OFFENSIVE_CONTENT
  INAPPROPRIATE_IMAGE
  WRONG_CATEGORY
  SUSPICIOUS_PAYMENT
  OTHER
}

enum ListingReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum RelocationStatus {
  PLANNING
  MOVING
  SETTLED
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  phone              String             @unique
  profilePicturePath String?
  occupationId       String?
  passwordHash       String
  isActive           Boolean            @default(true)
  accountStatus      AccountStatus      @default(ACTIVE)
  phoneVerifiedAt    DateTime?
  identityVerifiedAt DateTime?
  trustedSellerAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  userRoles          UserRole[]
  notifications      Notification[]
  refreshSessions    RefreshSession[]
  auditLogsAsActor   AuditLog[]         @relation("AuditActor")
  agentProfile       AgentProfile?
  driverProfile      DriverProfile?
  houses             House[]            @relation("HouseOwner")
  bookings           Booking[]
  cancelledBookings  Booking[]          @relation("BookingCancelledBy")
  wishlists          Wishlist[]
  movingRequests     MovingRequest[]    @relation("MovingRequester")
  assignedMovingRequests MovingRequest[] @relation("MovingAssignedDriver")
  movingStatusEventsAsActor MovingStatusEvent[] @relation("MovingStatusEventActor")
  movingEtaEntries   MovingEtaEntry[]
  roommatePosts      RoommatePost[]
  ratingReviewsGiven RatingReview[]     @relation("RatingReviewReviewer")
  ratingReviewsReceived RatingReview[]  @relation("RatingReviewTarget")
  listings           Listing[]          @relation("ListingSeller")
  purchasedListings  Listing[]          @relation("ListingBuyer")
  sellerContact      SellerContact?
  listingContactReveals ListingContactReveal[]
  listingReportsFiled ListingReport[]   @relation("ListingReportReporter")
  listingReportsReceived ListingReport[] @relation("ListingReportReportedUser")
  listingReportsHandled ListingReport[] @relation("ListingReportAdmin")
  movingOutSales     MovingOutSale[]
  relocationPreference RelocationPreference?
  agentSubscriptions AgentSubscription[]
  paymentOrders      PaymentOrder[]
  houseBoosts        HouseBoost[]
  occupation         Occupation?        @relation(fields: [occupationId], references: [id], onDelete: SetNull)
  housingPreference  HousingPreference?

  @@index([occupationId])

  @@index([accountStatus])
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]

  @@index([isActive])
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  rememberMe   Boolean   @default(false)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([targetType, targetId])
  @@index([actorUserId])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model PropertyType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  houses      House[]
  housingPreferences HousingPreference[]
}

model State {
  id          String   @id @default(cuid())
  name        String
  countryCode String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cities      City[]
  houses      House[]
  agentProfiles AgentProfile[]
  listings    Listing[]

  @@unique([name, countryCode])
  @@index([isActive])
}

model City {
  id               String   @id @default(cuid())
  name             String
  stateId          String
  countryCode      String
  postalCodePrefix String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  state            State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  houses           House[]
  agentProfiles    AgentProfile[]
  listings         Listing[]
  movingOutSalesFrom MovingOutSale[] @relation("MovingOutSaleOrigin")
  movingOutSalesTo MovingOutSale[]   @relation("MovingOutSaleDestination")
  relocationOrigins RelocationPreference[] @relation("RelocationOrigin")
  relocationDestinations RelocationPreference[] @relation("RelocationDestination")
  housingPreferences HousingPreference[]

  @@unique([name, stateId])
  @@index([isActive])
  @@index([stateId])
}

model ContractType {
  id             String   @id @default(cuid())
  name           String   @unique
  durationMonths Int
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  houses         House[]
}

model VehicleType {
  id            String   @id @default(cuid())
  name          String   @unique
  capacityLabel String?
  maxLoadKg     Int?
  description   String?
  pointFrom     Int?
  pointTo       Int?
  pricePerKm    Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  driverProfiles DriverProfile[]
  movingRequests MovingRequest[]
}

model DriverProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  name                      String
  companyName               String?
  nrc                       String
  nrcFrontPhotoPath         String
  nrcBackPhotoPath          String
  drivingLicensePhotoPath   String
  profilePhotoPath          String
  phone                     String
  currentAddress            String
  vehicleTypeId             String
  vehicleLicensePlateNumber String
  vehiclePhotoPath          String
  wheelTaxPhotoPath         String
  verificationStatus        VerificationStatus @default(PENDING)
  rejectionReason           String?  @db.VarChar(500)
  reviewedAt                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType               VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)

  @@index([vehicleTypeId])
  @@index([verificationStatus])
}

model MovingRequest {
  id                     String               @id @default(cuid())
  orderNumber            String               @unique
  requesterUserId        String
  assignedDriverUserId   String?
  vehicleTypeId          String
  pickupFloorLevelId     String?
  dropoffFloorLevelId    String?
  status                 MovingRequestStatus  @default(BOOKED)
  pickupAddress          String
  dropoffAddress         String
  pickupLatitude         Decimal?             @db.Decimal(10, 7)
  pickupLongitude        Decimal?             @db.Decimal(10, 7)
  dropoffLatitude        Decimal?             @db.Decimal(10, 7)
  dropoffLongitude       Decimal?             @db.Decimal(10, 7)
  distanceKm             Decimal?             @db.Decimal(10, 2)
  moveInDate             DateTime
  remarks                String?
  damageChecklist        String?
  totalInventoryPoints   Int                  @default(0)
  estimatedPrice         Decimal?             @db.Decimal(12, 2)
  pricePerKmUsed         Decimal?             @db.Decimal(12, 2)
  pickupFloorSurcharge   Decimal?             @db.Decimal(12, 2)
  dropoffFloorSurcharge  Decimal?             @db.Decimal(12, 2)
  estimatedEarnings      Decimal?             @db.Decimal(12, 2)
  acceptedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  requester              User                 @relation("MovingRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assignedDriver         User?                @relation("MovingAssignedDriver", fields: [assignedDriverUserId], references: [id], onDelete: SetNull)
  vehicleType            VehicleType          @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  pickupFloorLevel       FloorLevel?          @relation("MovingPickupFloor", fields: [pickupFloorLevelId], references: [id], onDelete: Restrict)
  dropoffFloorLevel      FloorLevel?          @relation("MovingDropoffFloor", fields: [dropoffFloorLevelId], references: [id], onDelete: Restrict)
  photos                 MovingRequestPhoto[]
  inventoryItems         MovingInventoryItem[]
  statusEvents           MovingStatusEvent[]
  etaEntries             MovingEtaEntry[]
  ratingReview           RatingReview?

  @@index([requesterUserId, createdAt])
  @@index([assignedDriverUserId, createdAt])
  @@index([status, assignedDriverUserId, createdAt])
  @@index([orderNumber])
  @@index([pickupFloorLevelId])
  @@index([dropoffFloorLevelId])
}

model MovingRequestPhoto {
  id              String   @id @default(cuid())
  movingRequestId String
  photoPath       String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  movingRequest   MovingRequest @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)

  @@index([movingRequestId])
}

model MovingInventoryItemType {
  id          String   @id @default(cuid())
  code        String   @unique
  category    String
  itemName    String
  points      Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requestItems MovingInventoryItem[]

  @@index([isActive, sortOrder])
  @@index([category])
}

model MovingInventoryItem {
  id                   String   @id @default(cuid())
  movingRequestId      String
  inventoryItemTypeId  String?
  category             String
  itemName             String
  count                Int
  pointsPerItem        Int      @default(0)
  linePoints           Int      @default(0)
  createdAt            DateTime @default(now())
  movingRequest        MovingRequest @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  inventoryItemType    MovingInventoryItemType? @relation(fields: [inventoryItemTypeId], references: [id], onDelete: SetNull)

  @@index([movingRequestId])
  @@index([category])
  @@index([inventoryItemTypeId])
}

model MovingStatusEvent {
  id              String                @id @default(cuid())
  movingRequestId String
  actorUserId     String?
  eventType       MovingStatusEventType
  status          MovingRequestStatus?
  notes           String?
  createdAt       DateTime              @default(now())
  movingRequest   MovingRequest         @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  actor           User?                 @relation("MovingStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([movingRequestId, createdAt])
  @@index([actorUserId])
  @@index([eventType])
}

model MovingEtaEntry {
  id              String   @id @default(cuid())
  movingRequestId String
  driverUserId    String
  stage           String
  etaAt           DateTime
  notes           String?
  createdAt       DateTime @default(now())
  movingRequest   MovingRequest @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  driver          User     @relation(fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([movingRequestId, createdAt])
  @@index([driverUserId])
}

model ServiceRegion {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agentProfiles AgentProfile[]

  @@unique([name, code])
}

model FloorLevel {
  id              String   @id @default(cuid())
  name            String   @unique
  levelNumber     Int?
  surchargeAmount Decimal  @default(0) @db.Decimal(12, 2)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  houses          House[]
  pickupMovingRequests  MovingRequest[] @relation("MovingPickupFloor")
  dropoffMovingRequests MovingRequest[] @relation("MovingDropoffFloor")
}

model Occupation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roommatePosts RoommatePost[]
  users       User[]
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  houseAmenities HouseAmenity[]
}

model AgentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  nrc                 String
  nrcFrontPhotoPath   String
  nrcBackPhotoPath    String
  email               String
  phone               String
  telegram            String?
  viber               String?
  address1            String
  address2            String?
  cityId              String
  stateId             String
  serviceRegionId     String
  hasRentingExperience Boolean
  verificationStatus  VerificationStatus @default(PENDING)
  rejectionReason     String?  @db.VarChar(500)
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city                City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  state               State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  serviceRegion       ServiceRegion @relation(fields: [serviceRegionId], references: [id], onDelete: Restrict)

  @@index([cityId])
  @@index([stateId])
  @@index([serviceRegionId])
  @@index([verificationStatus])
}

model House {
  id                 String                  @id @default(cuid())
  agentId            String
  title              String
  description        String?
  postChannel        HousePostChannel
  propertyTypeId     String
  monthlyFees        Decimal                 @db.Decimal(12, 2)
  depositAmount      Decimal                 @db.Decimal(12, 2)
  contractTypeId     String
  areaSize           String?
  floorLevelId       String?
  bedrooms           Int                     @default(0)
  bathrooms          Int                     @default(0)
  houseRules         String?
  contactTelegram    String?
  contactViber       String?
  contactPhoneNumber String
  cityId             String
  stateId            String
  streetAddress      String?
  latitude           Decimal?                @db.Decimal(10, 7)
  longitude          Decimal?                @db.Decimal(10, 7)
  nearbyPlaces       String?
  availability       HouseAvailabilityStatus @default(AVAILABLE)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  agent              User                    @relation("HouseOwner", fields: [agentId], references: [id], onDelete: Restrict)
  propertyType       PropertyType            @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  contractType       ContractType            @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  floorLevel         FloorLevel?             @relation(fields: [floorLevelId], references: [id], onDelete: SetNull)
  city               City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  state              State                   @relation(fields: [stateId], references: [id], onDelete: Restrict)
  images             HouseImage[]
  amenities          HouseAmenity[]
  bookings           Booking[]
  wishlists          Wishlist[]
  roommatePosts      RoommatePost[]
  boosts             HouseBoost[]
  events             HouseEvent[]

  @@index([agentId])
  @@index([propertyTypeId])
  @@index([contractTypeId])
  @@index([floorLevelId])
  @@index([cityId])
  @@index([stateId])
  @@index([availability])
  @@index([postChannel])
}

model RoommatePost {
  id                   String        @id @default(cuid())
  userId               String
  houseId              String
  title                String
  budgetCostSharing    String
  gender               RoommateGender
  occupationId         String
  isLgbtqFriendly      Boolean       @default(false)
  isCannabisFriendly   Boolean       @default(false)
  isSmokingFriendly    Boolean       @default(false)
  isNoSmoking          Boolean       @default(false)
  isCatFriendly        Boolean       @default(false)
  isDogFriendly        Boolean       @default(false)
  isAlcoholFriendly    Boolean       @default(false)
  likesNightOut        Boolean       @default(false)
  likesHangoutEveryday Boolean       @default(false)
  hobbyPlayingGame     Boolean       @default(false)
  hobbyWatchingMovies  Boolean       @default(false)
  hobbySinging         Boolean       @default(false)
  hobbyPlayingFootball Boolean       @default(false)
  hobbyRunning         Boolean       @default(false)
  hobbyCooking         Boolean       @default(false)
  hobbyReading         Boolean       @default(false)
  hobbyFoodie          Boolean       @default(false)
  hobbyChillWithOthers Boolean       @default(false)
  hobbyRelaxSilent     Boolean       @default(false)
  hobbyPlayingGym      Boolean       @default(false)
  photoPaths           String[]      @default([])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  house                House         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  occupation           Occupation    @relation(fields: [occupationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([houseId])
  @@index([occupationId])
  @@index([gender])
}

model HouseImage {
  id        String   @id @default(cuid())
  houseId   String
  imagePath String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
}

model HouseAmenity {
  id        String   @id @default(cuid())
  houseId   String
  amenityId String
  createdAt DateTime @default(now())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@unique([houseId, amenityId])
  @@index([amenityId])
}

model Booking {
  id                 String           @id @default(cuid())
  userId             String
  houseId            String
  status             BookingStatus    @default(CONFIRMED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByRole    CancelledByRole?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cancelledByUser    User?            @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  house              House            @relation(fields: [houseId], references: [id], onDelete: Cascade)
  ratingReview       RatingReview?

  @@index([userId])
  @@index([houseId])
  @@index([status])
  @@index([cancelledByUserId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  houseId   String?
  listingId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  house     House?   @relation(fields: [houseId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, houseId])
  @@unique([userId, listingId])
  @@index([userId])
  @@index([houseId])
  @@index([listingId])
}

model RatingReview {
  id              String           @id @default(cuid())
  reviewerUserId  String
  targetType      ReviewTargetType
  targetUserId    String
  rating          Int
  comment         String?          @db.VarChar(1000)
  bookingId       String?          @unique
  movingRequestId String?          @unique
  listingId       String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviewer        User             @relation("RatingReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  targetUser      User             @relation("RatingReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  movingRequest   MovingRequest?   @relation(fields: [movingRequestId], references: [id], onDelete: Cascade)
  listing         Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([reviewerUserId, createdAt])
  @@index([targetType, targetUserId, createdAt])
  @@index([rating])
}

model StatusCode {
  id         String   @id @default(cuid())
  entityType String
  code       String
  label      String
  color      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, code])
  @@index([isActive])
}

model MarketplaceCategory {
  id          String                @id @default(cuid())
  name        String
  nameMy      String?
  slug        String                @unique
  parentId    String?
  sortOrder   Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  parent      MarketplaceCategory?  @relation("MarketplaceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    MarketplaceCategory[] @relation("MarketplaceCategoryTree")
  listings    Listing[]             @relation("ListingCategory")
  subListings Listing[]             @relation("ListingSubcategory")

  @@index([parentId])
  @@index([isActive])
}

model Listing {
  id               String                  @id @default(cuid())
  sellerId         String
  title            String                  @db.VarChar(120)
  description      String                  @db.VarChar(4000)
  categoryId       String
  subcategoryId    String?
  price            Decimal                 @db.Decimal(12, 2)
  condition        ListingCondition
  stateId          String
  cityId           String
  locationDetail   String?                 @db.VarChar(200)
  pickupMethod     ListingPickupMethod
  showPhone        Boolean                 @default(true)
  showTelegram     Boolean                 @default(true)
  showViber        Boolean                 @default(true)
  status           ListingStatus           @default(ACTIVE)
  moderationStatus ListingModerationStatus @default(APPROVED)
  moderationNote   String?                 @db.VarChar(500)
  policyAcceptedAt DateTime
  buyerId          String?
  movingOutSaleId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  publishedAt      DateTime?
  soldAt           DateTime?
  seller           User                    @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer            User?                   @relation("ListingBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  category         MarketplaceCategory     @relation("ListingCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory      MarketplaceCategory?    @relation("ListingSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  state            State                   @relation(fields: [stateId], references: [id], onDelete: Restrict)
  city             City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  movingOutSale    MovingOutSale?          @relation(fields: [movingOutSaleId], references: [id], onDelete: SetNull)
  images           ListingImage[]
  wishlists        Wishlist[]
  contactReveals   ListingContactReveal[]
  reports          ListingReport[]
  review           RatingReview?

  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([cityId])
  @@index([status, moderationStatus, publishedAt])
  @@index([movingOutSaleId])
}

model ListingImage {
  id            String   @id @default(cuid())
  listingId     String
  imagePath     String
  optimizedPath String?
  thumbnailPath String?
  displayOrder  Int      @default(0)
  isCover       Boolean  @default(false)
  createdAt     DateTime @default(now())
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, displayOrder])
}

model SellerContact {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  telegramUsername String?
  viberNumber      String?
  showPhone        Boolean  @default(true)
  showTelegram     Boolean  @default(true)
  showViber        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListingContactReveal {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  method    String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId, method])
  @@index([listingId])
  @@index([userId])
}

model ListingReport {
  id             String              @id @default(cuid())
  reporterId     String
  listingId      String?
  reportedUserId String?
  reason         ListingReportReason
  description    String?             @db.VarChar(1000)
  status         ListingReportStatus @default(OPEN)
  adminId        String?
  adminNote      String?             @db.VarChar(500)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  reporter       User                @relation("ListingReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  listing        Listing?            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedUser   User?               @relation("ListingReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  admin          User?               @relation("ListingReportAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([reportedUserId])
}

model MovingOutSale {
  id                String    @id @default(cuid())
  sellerId          String
  title             String    @db.VarChar(120)
  description       String?   @db.VarChar(1000)
  originCityId      String
  destinationCityId String?
  moveOutDate       DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  seller            User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  originCity        City      @relation("MovingOutSaleOrigin", fields: [originCityId], references: [id], onDelete: Restrict)
  destinationCity   City?     @relation("MovingOutSaleDestination", fields: [destinationCityId], references: [id], onDelete: SetNull)
  listings          Listing[]

  @@index([sellerId])
  @@index([isActive, createdAt])
}

model RelocationPreference {
  id                String           @id @default(cuid())
  userId            String           @unique
  originCityId      String?
  destinationCityId String
  moveDate          DateTime?
  status            RelocationStatus @default(PLANNING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  originCity        City?            @relation("RelocationOrigin", fields: [originCityId], references: [id], onDelete: SetNull)
  destinationCity   City             @relation("RelocationDestination", fields: [destinationCityId], references: [id], onDelete: Restrict)
}

// --- Agent subscription plans, demo payments, boosts and listing analytics ---

/// Plan catalogue. Prices are whole MMK. Rules live here, not in frontend code.
model SubscriptionPlan {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  rank                Int                 @default(0)
  monthlyPriceMmk     Int                 @default(0)
  quarterlyPriceMmk   Int                 @default(0)
  /// New listings allowed per calendar month (Asia/Yangon). Null means no plan-based limit.
  monthlyListingLimit Int?
  /// Free boost days granted once per purchased subscription period.
  freeBoostDays       Int                 @default(0)
  badgeEligible       Boolean             @default(false)
  performanceLevel    String              @default("BASIC")
  audienceInsights    Boolean             @default(false)
  monthlyReport       Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  subscriptions       AgentSubscription[]
  paymentOrders       PaymentOrder[]
}

/// One row per purchased period. The effective plan is the row whose period contains "now".
model AgentSubscription {
  id             String           @id @default(cuid())
  userId         String
  planId         String
  billingMonths  Int
  startsAt       DateTime
  endsAt         DateTime
  paymentOrderId String           @unique
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentOrder   PaymentOrder     @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  freeBoosts     HouseBoost[]

  @@index([userId, endsAt])
}

/// A request to pay. Amount and contents are fixed by the server when the order is created.
model PaymentOrder {
  id            String               @id @default(cuid())
  reference     String               @unique
  userId        String
  /// SUBSCRIPTION | BOOST
  kind          String
  planId        String?
  billingMonths Int?
  houseId       String?
  boostDays     Int?
  amountMmk     Int
  currency      String               @default("MMK")
  /// PENDING | PAID | FAILED | EXPIRED
  status        String               @default("PENDING")
  provider      String
  /// Demo orders never represent real money and are kept apart from real payments.
  isDemo        Boolean              @default(false)
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan?    @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]
  subscription  AgentSubscription?
  boost         HouseBoost?

  @@index([userId, createdAt])
  @@index([status])
}

/// Every payment notification received for an order. eventId makes processing idempotent.
model PaymentTransaction {
  id        String       @id @default(cuid())
  orderId   String
  provider  String
  eventId   String       @unique
  /// SUCCESS | PENDING | FAILED
  outcome   String
  amountMmk Int
  isDemo    Boolean      @default(false)
  /// What the system did with the event: APPLIED | RECORDED | REJECTED
  result    String
  createdAt DateTime     @default(now())
  order     PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model HouseBoost {
  id             String             @id @default(cuid())
  houseId        String
  userId         String
  /// FREE_ENTITLEMENT | PURCHASED
  source         String
  days           Int
  startsAt       DateTime
  endsAt         DateTime
  cancelledAt    DateTime?
  subscriptionId String?
  paymentOrderId String?            @unique
  createdAt      DateTime           @default(now())
  house          House              @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   AgentSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentOrder   PaymentOrder?      @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([houseId, endsAt])
  @@index([userId, endsAt])
  @@index([subscriptionId])
}

/// Listing analytics. One row per visitor, per listing, per type, per day; no personal data is stored.
model HouseEvent {
  id         String   @id @default(cuid())
  houseId    String
  agentId    String
  /// VIEW | CALL | TELEGRAM | VIBER
  type       String
  /// Salted hash that changes daily; cannot be traced back to a person.
  visitorKey String
  /// Calendar day in Asia/Yangon, YYYY-MM-DD.
  day        String
  /// 0-23 in Asia/Yangon.
  hour       Int
  signedIn   Boolean  @default(false)
  createdAt  DateTime @default(now())
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([houseId, type, visitorKey, day])
  @@index([agentId, day])
  @@index([houseId, day])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// What a person is looking for in a home and in a roommate. Every field is optional:
/// matching only scores what was actually stated and never treats a blank as a match.
model HousingPreference {
  id              String        @id @default(cuid())
  userId          String        @unique
  budgetMin       Int?
  budgetMax       Int?
  preferredCityId String?
  propertyTypeId  String?
  bedroomsMin     Int?
  wantsFurnished  Boolean?
  needsInternet   Boolean?
  needsQuiet      Boolean?
  amenityIds      String[]      @default([])
  moveInDate      DateTime?
  leaseMonths     Int?
  roomArrangement String?
  cleanliness     String?
  sleepSchedule   String?
  smoking         String?
  noiseTolerance  String?
  socialLevel     String?
  guests          String?
  sharesChores    Boolean?
  /// Consent: only people who switch this on are ever suggested to housing agents.
  visibleToAgents Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCity   City?         @relation(fields: [preferredCityId], references: [id], onDelete: SetNull)
  propertyType    PropertyType? @relation(fields: [propertyTypeId], references: [id], onDelete: SetNull)

  @@index([visibleToAgents, preferredCityId])
  @@index([budgetMax])
}
